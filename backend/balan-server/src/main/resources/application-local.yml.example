# 复制为 application-local.yml 后填写本地中间件密码
# 仓库内默认主机都是 localhost；中间件不在本机时（例如跑在虚拟机/另一台机器），
# 把下面注释掉的主机地址取消注释并改成你的地址。
spring:
  datasource:
    # url: jdbc:mysql://127.0.0.1:3306/balancloud?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
    password: your_mysql_password
  data:
    redis:
      # host: 127.0.0.1
      password: your_redis_password

# balan:
#   security:
#     # 从 localhost 以外的地址访问前端时，把页面来源加进来（支持 * 端口通配），
#     # 否则浏览器在登录 POST 上带的 Origin 会被判 403 Invalid CORS request
#     allowed-origin-patterns: http://localhost:*,http://127.0.0.1:*,http://<你的访问地址>:*
#   mqtt:
#     broker-url: tcp://127.0.0.1:1883
#   tdengine:
#     url: http://127.0.0.1:6041
#   miniapp:
#     # 本地没有微信 AppID 时，用手机号开发登录（验证码固定 123456）
#     dev-login-enabled: true
#   wechat:
#     app-id: your_wechat_appid
#     app-secret: your_wechat_secret

logging:
  level:
    com.balancloud: debug
